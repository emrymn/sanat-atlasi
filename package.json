{
  "name": "sanat-atlasi",
  "version": "1.0.0",
  "private": true,
  "description": "Kişisel sanat tarihi çalışma PWA'sı (statik dosyalar, derleme adımı yok)",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test --project=chromium",
    "test:webkit": "playwright test --project=webkit",
    "serve": "node scripts/sunucu.mjs",
    "onbellek": "node scripts/onbellek.mjs",
    "ikonlar": "node scripts/ikonlar.mjs",
    "oranlar": "node scripts/oranlar.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
