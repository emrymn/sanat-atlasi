%3E%3C%2Fg%3E%3C%2Fsvg%3E");
 }
+
+/* İş 175: eser dersi (#/basyapit/<anahtar>/ders) */
+.eser-dersi {
+  padding-bottom: 32px;
+}
+.drs-taslak {
+  margin: 12px 0;
+  padding: 12px 14px;
+  border-radius: 14px;
+  border: 1px solid var(--wrong);
+  background: var(--wrong-bg);
+  color: var(--ink);
+  font: 400 15px/1.45 var(--sans);
+}
+.drs-sekmeler {
+  position: sticky;
+  top: env(safe-area-inset-top, 0px);
+  z-index: 3;
+  display: flex;
+  gap: 6px;
+  margin: 14px -4px 10px;
+  padding: 6px 4px;
+  background: var(--bg);
+  overflow-x: auto;
+  scrollbar-width: none;
+}
+.drs-sekme {
+  flex: 1 0 auto;
+  min-height: 44px;
+  padding: 0 14px;
+  border-radius: 22px;
+  border: 1px solid var(--border);
+  background: var(--surface);
+  color: var(--ink-2);
+  font: 600 14px var(--sans);
+  cursor: pointer;
+}
+.drs-sekme[aria-selected='true'] {
+  background: var(--vurgu);
+  border-color: var(--vurgu);
+  color: var(--vurgu-yazi);
+}
+.drs-metin h2,
+.drs-metin h3,
+.drs-metin h4 {
+  margin: 26px 0 8px;
+  font-size: 1.15em;
+  line-height: 1.25;
+}
+.drs-metin p,
+.drs-metin ul,
+.drs-metin ol,
+.drs-metin blockquote {
+  margin: 0 0 14px;
+}
+.drs-metin ul,
+.drs-metin ol {
+  padding-left: 22px;
+}
+.drs-metin li {
+  margin-bottom: 6px;
+}
+.drs-metin blockquote {
+  padding-left: 14px;
+  border-left: 3px solid var(--border);
+  color: var(--ink-2);
+}
+.drs-metin hr {
+  border: 0;
+  border-top: 1px solid var(--border);
+  margin: 22px 0;
+}
+.drs-metin code {
+  font-size: 0.9em;
+  overflow-wrap: anywhere;
+}
+.drs-tablo {
+  overflow-x: auto;
+  margin: 0 0 14px;
+}
+.drs-tablo table {
+  border-collapse: collapse;
+  font: 400 14px/1.4 var(--sans);
+}
+.drs-tablo th,
+.drs-tablo td {
+  padding: 6px 10px;
+  border: 1px solid var(--border);
+  text-align: left;
+  vertical-align: top;
+  min-width: 90px;
+}
+.drs-kanit {
+  margin-left: 2px;
+  padding: 3px 2px;
+  color: var(--ink-3);
+  font: 600 10px var(--sans);
+  cursor: pointer;
+}
+.drs-sorular {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+.drs-soru {
+  margin: 0 0 26px;
+}
+.drs-soru-metni {
+  margin: 0 0 10px;
+  font-weight: 600;
+}
+.drs-secenekler {
+  display: grid;
+  gap: 8px;
+}
+.drs-secenek {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-height: 48px;
+  padding: 8px 14px;
+  border-radius: 14px;
+  border: 1px solid var(--border);
+  background: var(--surface);
+  color: var(--ink);
+  font: 400 16px/1.35 var(--sans);
+  text-align: left;
+  cursor: pointer;
+}
+.drs-secenek .harf {
+  flex: none;
+  color: var(--ink-3);
+  font-weight: 700;
+}
+.drs-secenek.dogru {
+  border-color: var(--right);
+  background: var(--right-bg);
+}
+.drs-secenek.yanlis {
+  border-color: var(--wrong);
+  background: var(--wrong-bg);
+}
+.drs-gerekce {
+  margin: 10px 0 0;
+  color: var(--ink-2);
+  font: 400 15px/1.45 var(--sans);
+}
