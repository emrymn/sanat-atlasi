+import { test, expect } from '@playwright/test';
+import { readFileSync } from 'node:fs';
+import { agiHazirla } from './ortak.js';
+
+// İş 175: eser dersi yayın kapısı. Gerçek başyapıt verisi ve gerçek ders dosyaları (Mantegna, Ölü İsa) kullanılır;
+// yalnız kapı dosyası (data/ders_yayin.json) testte değiştirilir.
+const K = 'Q546297';
+const kapi = JSON.parse(readFileSync(new URL('../../data/ders_yayin.json', import.meta.url), 'utf8'));
+const kapiVer = (context, onayli) =>
+  context.route(/\/data\/ders_yayin\.json(\?.*)?$/, (r) => r.fulfill({ status: 200, contentType: 'application/json', body: JSON.stringify({ ...kapi, onayli }) }));
+
+test('onaylanmamış ders görünmez: başyapıt sayfasında giriş yok, adres de açılmaz', async ({ page, context }) => {
+  await agiHazirla(context);
+  await kapiVer(context, []);
+  await page.goto(`./#/basyapit/${K}`);
+  await expect(page.locator('[data-test="basyapit"] h1')).toBeVisible();
+  await expect(page.locator('[data-basyapit-gorsel] img')).toBeAttached();
+  await expect(page.locator('[data-test="basyapit-ders"]')).toHaveCount(0);
+  await page.goto(`./#/basyapit/${K}/ders`);
+  await expect(page.locator('#uygulama')).toContainText('henüz yayında değil');
+  await expect(page.locator('[data-test="eser-dersi"]')).toHaveCount(0);
+});
+
+test('onaylı ders: giriş → üç seviye → sorular; taslak uyarısı yok; yatay taşma yok', async ({ page, context }) => {
+  await agiHazirla(context);
+  await kapiVer(context, [K]);
+  await page.goto(`./#/basyapit/${K}`);
+  await page.locator('[data-test="basyapit-ders"]').click();
+  const ders = page.locator('[data-test="eser-dersi"]');
+  await expect(ders.locator('[data-test="ders-metni"]')).toContainText('Bir bakışta kimlik');
+  await expect(ders.locator('[data-test="ders-taslak"]')).toHaveCount(0);
+  await ders.locator('[data-drs-sekme="orta"]').click();
+  await expect(ders.locator('[data-test="ders-metni"]')).toContainText('Tarihsel bağlam');
+  await ders.locator('[data-drs-sekme="ileri"]').click();
+  await expect(ders.locator('[data-drs-sekme="ileri"]')).toHaveAttribute('aria-selected', 'true');
+  await expect(ders.locator('[data-test="ders-metni"] h3').first()).toBeVisible();
+  expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);
+  await ders.locator('[data-drs-sekme="sorular"]').click();
+  const ilk = ders.locator('[data-drs-soru="0"]');
+  await ilk.locator('.drs-secenek[data-harf="A"]').click(); // CS01'in doğrusu A
+  await expect(ilk.locator('.drs-secenek.dogru')).toHaveCount(1);
+  await expect(ilk.locator('.drs-gerekce')).toContainText('Doğru.');
+  await ders.locator('[data-drs-soru="1"] .drs-secenek').first().click();
+  await expect(ders.locator('[data-test="ders-puan"]')).toContainText('/ 2 doğru');
+  // geri: başyapıt sayfası
+  await page.locator('[data-geri]').click();
+  await expect(page.locator('[data-test="basyapit"]')).toBeVisible();
+});
+
+test('geliştirici modunda onaylanmamış ders taslak uyarısıyla açılır', async ({ page, context }) => {
+  await agiHazirla(context);
+  await kapiVer(context, []);
+  await page.goto('./#/ayarlar');
+  await page.locator('[data-ayar-gelistirici]').check();
+  await page.goto(`./#/basyapit/${K}`);
+  await expect(page.locator('[data-test="basyapit-ders"]')).toContainText('taslak');
+  await page.locator('[data-test="basyapit-ders"]').click();
+  await expect(page.locator('[data-test="ders-taslak"]')).toContainText('onaylanmadı');
+  await expect(page.locator('[data-test="ders-metni"]')).toContainText('Bir bakışta kimlik');
+});
