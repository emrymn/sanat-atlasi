diff --git a/js/ekranlar/eserDersi.js b/js/ekranlar/eserDersi.js
new file mode 100644
index 0000000..b86e3fd
--- /dev/null
+++ b/js/ekranlar/eserDersi.js
@@ -0,0 +1,134 @@
+// Eser dersi ekranı (#/basyapit/<anahtar>/ders): üç seviye okuma + çoktan seçmeli sorular.
+// Dersler basyapit-dersleri/ klasöründen isteğe bağlı yüklenir; kapı data/ders_yayin.json. Bkz. KARARLAR.md "İş 175".
+import { kacis } from '../yardimci.js';
+import { basyapitBul } from '../basyapit.js';
+import { yayinAl, dersDurumu, dersGorunurMu, dersKlasoru, dersYolu, mdHtml, kanitDizini, sorulariAl, SEVIYELER, SEVIYE_ADLARI } from '../eserDersi.js';
+import { d, ekran, jsonGetir, ciz, cizimNo, guncelMi, hataGoster, geriDugmesi, bildir, akimRenk, ekranRengi } from './ortak.js';
+import { basyapitVeri, basyapitAdresi } from './gozat.js';
+
+const DOSYA = { baslangic: 'DERS_BASLANGIC.md', orta: 'DERS_ORTA.md', ileri: 'DERS_ILERI.md' };
+
+let yayinSozu = null;
+export function dersYayini() {
+  if (!yayinSozu)
+    yayinSozu = jsonGetir('data/ders_yayin.json').then(yayinAl, () => {
+      yayinSozu = null; // dosya yoksa ders yok; uygulama aynen çalışır
+      return yayinAl(null);
+    });
+  return yayinSozu;
+}
+
+export const dersAdresi = (anahtar) => `${basyapitAdresi(anahtar)}/ders`;
+export const dersinDurumu = (yayin, anahtar) => dersDurumu(yayin, anahtar, Boolean(d.ilerleme.gelistirici));
+
+async function metinGetir(yol) {
+  const y = await fetch(yol);
+  if (!y.ok) throw new Error(`${yol}: ${y.status}`);
+  return y.text();
+}
+
+const TASLAK_UYARI =
+  '<p class="drs-taslak" data-test="ders-taslak"><b>Taslak.</b> Bu dersi Qwen yazdı; bağımsız denetimi bitmedi ve onaylanmadı. Olgu, tarih ve kaynak hataları içerebilir. Yalnız geliştirici modunda görünür.</p>';
+
+export async function eserDersiSayfasi(kodlu) {
+  const anahtar = decodeURIComponent(kodlu);
+  const no = cizimNo();
+  const [liste, yayin] = await Promise.all([basyapitVeri(), dersYayini()]);
+  if (!guncelMi(no)) return;
+  const b = basyapitBul(liste, anahtar);
+  const durum = dersinDurumu(yayin, anahtar);
+  if (!b || !dersGorunurMu(durum)) return hataGoster(new Error('Bu eserin dersi henüz yayında değil.'));
+  const klasor = dersKlasoru(yayin, anahtar);
+  const s = d.harita.get(b.sanatci);
+  ekranRengi(Promise.resolve(null), akimRenk(s.akim));
+  const sekmeler = [...SEVIYELER.map((k) => [k, SEVIYE_ADLARI[k]]), ['sorular', 'Sorular']];
+  ciz(`<header class="sanatci-ust">${geriDugmesi(basyapitAdresi(anahtar))}<span class="etiket vurgu">Ders</span></header>
+    <article class="eser-dersi" data-test="eser-dersi">
+      <h1 class="basyapit-ad" tabindex="-1">${kacis(b.baslik)}</h1>
+      <p class="meta"><a href="#/sanatci/${encodeURIComponent(s.id)}">${kacis(s.ad)}</a>${b.tarih ? ` · ${kacis(b.tarih)}` : ''}</p>
+      ${durum === 'taslak' ? TASLAK_UYARI : ''}
+      <div class="drs-sekmeler" role="tablist">${sekmeler.map(([k, ad], i) => `<button type="button" role="tab" class="drs-sekme" data-drs-sekme="${k}" aria-selected="${i ? 'false' : 'true'}">${ad}</button>`).join('')}</div>
+      <div class="drs-govde" data-drs-govde><p class="ikincil kucuk">Yükleniyor…</p></div>
+    </article>`);
+  const govde = ekran.querySelector('[data-drs-govde]');
+  const dersSozu = jsonGetir(dersYolu(klasor, 'DERS.json')).then(kanitDizini, () => new Map());
+  const bellek = new Map();
+  const icerik = (sekme) => {
+    if (!bellek.has(sekme))
+      bellek.set(
+        sekme,
+        sekme === 'sorular'
+          ? jsonGetir(dersYolu(klasor, 'SORULAR.json')).then((j) => ({ sorular: sorulariAl(j) }))
+          : metinGetir(dersYolu(klasor, DOSYA[sekme])).then((md) => ({ html: mdHtml(md) })),
+      );
+    return bellek.get(sekme);
+  };
+  let secili = null;
+  const ac = async (sekme) => {
+    secili = sekme;
+    for (const el of ekran.querySelectorAll('[data-drs-sekme]')) el.setAttribute('aria-selected', String(el.dataset.drsSekme === sekme));
+    govde.innerHTML = '<p class="ikincil kucuk">Yükleniyor…</p>';
+    let x;
+    try {
+      x = await icerik(sekme);
+    } catch (err) {
+      bellek.delete(sekme);
+      if (guncelMi(no) && secili === sekme) govde.innerHTML = '<p class="ikincil">Ders yüklenemedi. Bağlantını denetleyip yeniden dene.</p>';
+      return;
+    }
+    if (!guncelMi(no) || secili !== sekme) return;
+    if (sekme === 'sorular') sorulariCiz(govde, x.sorular);
+    else govde.innerHTML = `<div class="okuma drs-metin" data-test="ders-metni">${x.html}</div>`;
+    window.scrollTo(0, 0);
+  };
+  ekran.querySelector('.drs-sekmeler').addEventListener('click', (e) => {
+    const dg = e.target.closest('[data-drs-sekme]');
+    if (dg && dg.dataset.drsSekme !== secili) ac(dg.dataset.drsSekme);
+  });
+  // kanıt etiketine dokununca: iddia ve dayandığı kaynakların adı
+  govde.addEventListener('click', async (e) => {
+    const k = e.target.closest('[data-kanit]');
+    if (!k) return;
+    const iddia = (await dersSozu).get(k.dataset.kanit);
+    if (iddia) bildir(`${k.dataset.kanit}: ${iddia.ifade}${iddia.kaynaklar.length ? ` — ${iddia.kaynaklar.join('; ')}` : ''}`, { sure: 9000 });
+  });
+  await ac('baslangic');
+}
+
+function sorulariCiz(govde, sorular) {
+  if (!sorular.length) {
+    govde.innerHTML = '<p class="ikincil">Bu dersin sorusu yok.</p>';
+    return;
+  }
+  let dogru = 0;
+  let yanit = 0;
+  govde.innerHTML = `<p class="drs-puan ikincil kucuk" data-test="ders-puan" aria-live="polite">${sorular.length} soru</p>
+    <ol class="drs-sorular">${sorular
+      .map(
+        (s, i) => `<li class="drs-soru" data-drs-soru="${i}"><p class="drs-soru-metni">${kacis(s.soru)}</p>
+        <div class="drs-secenekler">${s.secenekler.map((o) => `<button type="button" class="drs-secenek" data-harf="${kacis(o.harf)}"><span class="harf">${kacis(o.harf)}</span><span>${kacis(o.metin)}</span></button>`).join('')}</div>
+        <p class="drs-gerekce" hidden></p></li>`,
+      )
+      .join('')}</ol>`;
+  govde.querySelector('.drs-sorular').addEventListener('click', (e) => {
+    const dg = e.target.closest('.drs-secenek');
+    const li = dg && dg.closest('[data-drs-soru]');
+    if (!li || li.dataset.bitti) return;
+    const s = sorular[Number(li.dataset.drsSoru)];
+    const secim = dg.dataset.harf;
+    li.dataset.bitti = '1';
+    for (const o of li.querySelectorAll('.drs-secenek')) {
+      o.disabled = true;
+      if (o.dataset.harf === s.dogru) o.classList.add('dogru');
+      else if (o === dg) o.classList.add('yanlis');
+    }
+    const iyi = secim === s.dogru;
+    yanit++;
+    if (iyi) dogru++;
+    const g = li.querySelector('.drs-gerekce');
+    const ek = !iyi && typeof s.yanlis[secim] === 'string' ? s.yanlis[secim] : '';
+    g.innerHTML = `<b>${iyi ? 'Doğru.' : 'Yanlış.'}</b> ${kacis([ek, s.gerekce].filter(Boolean).join(' '))}`;
+    g.hidden = false;
+    govde.querySelector('[data-test="ders-puan"]').textContent = `${dogru} / ${yanit} doğru · ${sorular.length} soru`;
+  });
+}
